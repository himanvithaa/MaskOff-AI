# MaskOff AI - Environment Configuration

# Flask Core
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=maskoff-super-secret-production-key-2025-at-least-32-bytes
JWT_SECRET_KEY=maskoff-jwt-super-secret-key-production-3030-auth-token-length

# Database Configuration
# Leave empty for automatic local SQLite fallback (maskoff.db)
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# AI Provider Configuration
# Options: 'mock' (default, high-fidelity local demo with 0 keys needed), 'groq', 'gemini', or 'openai'
AI_PROVIDER=groq

# Groq API Key (Recommended for ultra-fast, free conversational LPU inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini API Key (Optional)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Speech Processing
# Options: 'auto', 'whisper_api', 'local_whisper', 'browser_fallback'
STT_ENGINE=auto

